# Copy this file to .env and add your Hugging Face API key.
# Never commit your real API key to source control.

HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=google/flan-t5-large
# Optional: override the chat endpoint if you want to use a separate backend URL.
# VITE_CHAT_API_URL=http://localhost:5174/chat
